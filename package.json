{
  "name": "rungs",
  "version": "0.1.0",
  "private": true,
  "description": "Companies post challenges, students climb the ladder: mini challenges, team projects, and hidden skill-balanced team sorting.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"node --watch server/index.js --dev\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "seed": "node server/seed.js --reset",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.5.0",
    "concurrently": "9.1.2",
    "vite": "6.3.5"
  }
}
